{
  "name": "node-test",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#/*": "./src/*"
  },
  
  "scripts": {
    "build": "tsc -b",
    "start": "npm run build && node dist/main.js",
    "devV2": "nodemon -x tsx src/main.ts | pino-pretty --colorize --translateTime=\"SYS:yyyy-mm-dd HH:MM:ss.l\"",
    "dev": "tsx watch src/main.ts | pino-pretty --colorize --translateTime=\"SYS:yyyy-mm-dd HH:MM:ss.l\"",
    "clear": "tsx src/debug/clear.ts | pino-pretty",
    "debug": "tsx src/debug/debug.ts | pino-pretty",
    "test": "sh -c 'ts-node -r tsconfig-paths/register $1 | pino-pretty --colorize' --"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "execa": "^9.6.0",
    "express": "^5.1.0",
    "file-type": "^21.3.4",
    "image-size": "^2.0.2",
    "multer": "^2.0.1",
    "p-limit": "^7.0.0",
    "pino": "^10.3.1",
    "sse": "^0.0.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/execa": "^0.9.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/p-limit": "^2.1.0",
    "@types/sse": "^0.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}
